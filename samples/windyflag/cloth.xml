<?xml version="1.0"?>
<mclScene> <!-- This is a simple scene that demonstrates the use of the ADMM elastic solver. It consists of a flag attached to a pole, with gravity and wind forces applied to it. -->

	<Object name="cloth1" type="plane" >

		<!-- Width and length just provide tesselation -->
		<width value="30" />
		<length value="20" />

		<Material value="white_flag" />
		<Mass value=".5" />
		<Force value="admmstyle" />
		<Force value="bend" />
		<scale value="0.75 0.5 0.5" /> <!-- makes it 1.5m x 1m -->
		<translate value="0.035 0 0" /> <!-- so anchor nodes are not inside pole -->
		
	</Object>


	<Object name="pole" type="cylinder" >

		<tess_l value="10" /> <!-- longitudinal tessellation -->
		<tess_c value="10" /> <!-- circular tessellation -->

		<Material value="gray" />

		<translate value="-0.75 -0.75 0" />
		<rotate value="90 0 0" />
		<scale value="0.025 0.025 1.5" />

	</Object>

	<Material name="gray" type="blinnphong" >
		<Diffuse value=".2  .2  .2" />
		<specular value=".2  .2  .2" />
	</Material>

	<Material name="white_flag" type="blinnphong" >
		<Diffuse value=".6  .6  .6" /> <!-- Diffuse color is a light gray -->
		<specular value="0  0  0" /> <!-- Specular color is black, meaning no specular reflection -->
		<texture value="sca16logo2.png" /> <!-- Texture file for the flag -->
	</Material>

</mclScene>
<admmelastic> <!-- This section defines the forces and solver settings for the ADMM elastic simulation. -->

	<Force name="gravity" type="ExplicitForce" >
		<direction value="0 -9.8 0" />  <!-- Gravity force in the negative y-direction -->
	</Force>

	<Force name="admmstyle" type="TriangleStrain" >
		<limit value=".95 1.05" />
		<Stiffness value="100" />
	</Force>
	
	<Force name="bend" type="Bend" >
		<Stiffness value="20" />
	</Force>

	<solver>
		<iterations value="30" />
		<timestep value="0.04" />
	</solver>

</admmelastic>

